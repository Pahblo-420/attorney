---
const links = [
  { 
    href: "/", 
    label: "Home",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`
  },
  { 
    href: "/about", 
    label: "About",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    href: "/practice-areas",
    label: "Practice Areas",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>`,
    subLinks: [
      { href: "/practice-areas/personal-injury", label: "Personal Injury" },
      { href: "/practice-areas/family-law", label: "Family Law" },
      { href: "/practice-areas/criminal-defense", label: "Criminal Defense" },
    ],
  },
  { 
    href: "/our-attorneys", 
    label: "Our Attorneys",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  { 
    href: "/insights", 
    label: "Insights / FAQs",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>`
  },
  { 
    href: "/contact", 
    label: "Contact",
    icon: `<svg class="h-5 w-5 text-slate/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`
  },
];

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isActive = (href: string) =>
  href === "/"
    ? pathname === "/"
    : pathname === href || pathname.startsWith(`${href}/`);

const focusStyles =
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 focus-visible:ring-offset-ivory";
---

<header 
  id="main-header"
  class="is-transparent fixed top-0 z-50 w-full border-b border-transparent bg-transparent transition-colors duration-300 ease-in-out"
>
  <attorneys-nav class="block">
    <nav
      aria-label="Main navigation"
      class="mx-auto max-w-7xl px-4 sm:px-6 xl:px-8 relative"
    >
      <div class="flex min-h-16 items-center justify-between gap-4 md:min-h-20">
        <!-- Logo -->
        <a
          href="/"
          aria-label="Pahblo’s Attorneys — home"
          class:list={["brand-logo flex shrink-0 items-center rounded-sm", focusStyles]}
        >
          <img
            src="/images/pahblo_attorneys_logo.webp"
            alt="Pahblo’s Attorneys"
            width="180"
            height="100"
            loading="eager"
            class="h-12 w-auto object-contain transition-[filter] duration-300 md:h-14 lg:h-16"
          />
        </a>

        <!-- Desktop links (laptop and up) -->
        <ul class="hidden items-center lg:flex gap-1">
          {
            links.map((link) => (
              <li class={link.subLinks ? "group relative" : ""}>
                <a
                  href={link.href}
                  aria-current={pathname === link.href ? "page" : undefined}
                  class:list={[
                    "desktop-link relative inline-flex min-h-11 items-center gap-1.5 whitespace-nowrap rounded-sm px-2.5 text-sm transition-colors duration-200 ease-out motion-safe:hover:-translate-y-0.5 motion-reduce:transition-none xl:px-3",
                    "after:absolute after:inset-x-2.5 after:bottom-1 after:h-0.5 after:origin-left after:bg-navy after:transition-transform motion-reduce:after:transition-none xl:after:inset-x-3",
                    focusStyles,
                    isActive(link.href)
                      ? "is-active font-semibold text-navy after:scale-x-100"
                      : "text-slate after:scale-x-0 hover:text-navy hover:after:scale-x-100",
                  ]}
                >
                  {link.label}
                  {link.subLinks && (
                    <svg class="h-4 w-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  )}
                </a>
                
                {/* Desktop Dropdown (These links intentionally stay dark) */}
                {link.subLinks && (
                  <ul class="absolute left-0 top-full hidden w-56 flex-col rounded-sm border border-stone bg-ivory py-2 shadow-lg group-hover:flex">
                    {link.subLinks.map((subLink) => (
                      <li>
                        <a 
                          href={subLink.href}
                          class="block px-4 py-2.5 text-sm text-slate transition-colors hover:bg-navy/5 hover:text-navy"
                        >
                          {subLink.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>

        <!-- Right side: consultation button + menu button -->
        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <a
            href="/contact#consultation"
            class:list={[
              "hidden min-h-11 items-center justify-center whitespace-nowrap rounded-sm bg-navy px-4 py-2.5 text-sm font-semibold text-white transition duration-200 ease-out hover:bg-navy/90 motion-safe:hover:-translate-y-0.5 motion-reduce:transition-none md:inline-flex lg:px-5",
              focusStyles,
            ]}
          >
            Book a Consultation
          </a>

          <!-- Menu button -->
          <button
            type="button"
            data-menu-toggle
            aria-expanded="false"
            aria-controls="mobile-navigation"
            class:list={[
              "inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-sm px-3 text-sm font-semibold text-navy transition-colors hover:bg-navy/5 motion-reduce:transition-none lg:hidden",
              focusStyles,
            ]}
          >
            <span data-menu-label>Menu</span>
            
            <svg
              data-menu-open-icon
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            >
              <path d="M4 6h16M4 12h16M4 18h8"></path>
            </svg>

            <svg
              data-menu-close-icon
              class="hidden"
              aria-hidden="true"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
            >
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile / tablet menu panel -->
      <div
        id="mobile-navigation"
        data-mobile-menu
        hidden
        class="absolute right-0 top-full flex max-h-[calc(100dvh-4rem)] w-[75vw] flex-col overflow-y-auto border-b border-l border-stone bg-ivory shadow-2xl md:max-h-[calc(100dvh-5rem)] lg:hidden"
      >
        <ul class="flex flex-col">
          {
            links.map((link) => (
              <li class="border-b border-stone/50 last:border-none">
                {link.subLinks ? (
                  <details class="group">
                    <summary class:list={[
                      "flex min-h-12 cursor-pointer list-none items-center justify-between border-l-2 border-transparent px-5 py-3 text-base text-slate transition-colors hover:bg-navy/5",
                      focusStyles
                    ]}>
                      <span class="flex items-center gap-3">
                        <Fragment set:html={link.icon} />
                        <span class={isActive(link.href) ? "font-semibold text-navy" : ""}>
                          {link.label}
                        </span>
                      </span>
                      <svg class="h-5 w-5 text-slate/50 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>
                    <ul class="bg-stone/5 pb-3 pl-10 pr-5 pt-1">
                      {link.subLinks.map((subLink) => (
                        <li>
                          <a
                            href={subLink.href}
                            class="flex min-h-10 items-center justify-between py-2 text-sm text-slate transition-colors hover:text-navy"
                          >
                            {subLink.label}
                            <svg class="h-4 w-4 text-slate/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a
                    href={link.href}
                    aria-current={pathname === link.href ? "page" : undefined}
                    class:list={[
                      "flex min-h-12 items-center justify-between border-l-2 px-5 py-3 text-base transition-colors motion-reduce:transition-none",
                      focusStyles,
                      isActive(link.href)
                        ? "border-navy bg-navy/5 font-semibold text-navy"
                        : "border-transparent text-slate hover:bg-navy/5 hover:text-navy",
                    ]}
                  >
                    <span class="flex items-center gap-3">
                      <Fragment set:html={link.icon} />
                      {link.label}
                    </span>
                    <svg class="h-5 w-5 text-slate/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                )}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 mb-10 flex w-full justify-center md:hidden">
          <a
            href="/contact#consultation"
            class:list={[
              "inline-flex w-fit min-h-12 items-center justify-center rounded-sm bg-navy px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-navy/90 motion-reduce:transition-none",
              focusStyles,
            ]}
          >
            Book a Consultation
          </a>
        </div>
      </div>
    </nav>
  </attorneys-nav>
</header>

<style>
  [hidden] {
    display: none !important;
  }

  attorneys-nav:not(:defined) [data-menu-toggle] {
    display: none;
  }

  @media (max-width: 1023px) {
    attorneys-nav:not(:defined) [data-mobile-menu] {
      display: block !important;
    }
  }

  /* --- TRANSPARENT HEADER OVERRIDES --- */
  /* These rules apply ONLY when the user is at the top of the page */
  #main-header.is-transparent .brand-logo img {
    /* Turns a dark logo into pure white */
    filter: brightness(0) invert(1);
  }
  #main-header.is-transparent .desktop-link {
    color: rgba(255, 255, 255, 0.85);
  }
  #main-header.is-transparent .desktop-link.is-active,
  #main-header.is-transparent .desktop-link:hover {
    color: #ffffff;
  }
  #main-header.is-transparent .desktop-link::after {
    background-color: #ffffff;
  }
  #main-header.is-transparent .desktop-link svg {
    color: rgba(255, 255, 255, 0.85);
  }
  #main-header.is-transparent .desktop-link:hover svg {
    color: #ffffff;
  }
  #main-header.is-transparent [data-menu-toggle] {
    color: #ffffff;
  }
  #main-header.is-transparent [data-menu-toggle]:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>

<script>
  class AttorneysNav extends HTMLElement {
    private cleanup?: AbortController;

    connectedCallback() {
      this.cleanup?.abort();

      const controller = new AbortController();
      this.cleanup = controller;
      const { signal } = controller;

      const toggle = this.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const menu = this.querySelector<HTMLElement>("[data-mobile-menu]");
      const label = this.querySelector<HTMLElement>("[data-menu-label]");
      const openIcon = this.querySelector<SVGElement>("[data-menu-open-icon]");
      const closeIcon = this.querySelector<SVGElement>("[data-menu-close-icon]");
      const brand = this.querySelector<HTMLAnchorElement>("a[href='/']");
      const header = document.getElementById("main-header");

      if (!toggle || !menu || !header) return;

      const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

      // Scroll Event: Toggle background and text colors
      const updateHeaderScrollState = () => {
        // Do not make the header transparent if the mobile menu is currently open
        if (isOpen()) return;

        if (window.scrollY > 20) {
          header.classList.add("bg-ivory", "border-stone");
          header.classList.remove("bg-transparent", "border-transparent", "is-transparent");
        } else {
          header.classList.add("bg-transparent", "border-transparent", "is-transparent");
          header.classList.remove("bg-ivory", "border-stone");
        }
      };

      window.addEventListener("scroll", updateHeaderScrollState, { passive: true });
      updateHeaderScrollState();

      // Mobile Menu Toggle logic
      const setOpen = (open: boolean, restoreFocus = false) => {
        toggle.setAttribute("aria-expanded", String(open));
        menu.hidden = !open;

        if (label) {
          label.textContent = open ? "Close" : "Menu";
        }

        openIcon?.classList.toggle("hidden", open);
        closeIcon?.classList.toggle("hidden", !open);

        // UI Fix: Force header to be solid Ivory when mobile menu opens so it matches the panel
        if (open) {
          header.classList.add("bg-ivory", "border-stone");
          header.classList.remove("bg-transparent", "border-transparent", "is-transparent");
        } else {
          updateHeaderScrollState(); // Revert back to proper scroll state when closed
        }

        if (restoreFocus) {
          toggle.focus();
        }
      };

      setOpen(false);
      toggle.addEventListener("click", () => setOpen(!isOpen()), { signal });

      this.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape" && isOpen()) {
            event.preventDefault();
            setOpen(false, true);
          }
        },
        { signal },
      );

      menu.addEventListener(
        "click",
        (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            setOpen(false, true);
          }
        },
        { signal },
      );

      document.addEventListener(
        "click",
        (event) => {
          if (isOpen() && event.target instanceof Node && !this.contains(event.target)) {
            const focusWasInMenu = menu.contains(document.activeElement);
            setOpen(false, focusWasInMenu);
          }
        },
        { signal },
      );

      this.addEventListener(
        "focusout",
        (event) => {
          if (event.relatedTarget instanceof Node && !this.contains(event.relatedTarget)) {
            setOpen(false);
          }
        },
        { signal },
      );

      const desktop = window.matchMedia("(min-width: 1024px)");
      desktop.addEventListener(
        "change",
        () => {
          const focusWasInMenu = menu.contains(document.activeElement);
          const focusWasOnToggle = document.activeElement === toggle;

          setOpen(false);

          if (desktop.matches && (focusWasInMenu || focusWasOnToggle)) {
            brand?.focus();
          } else if (!desktop.matches && focusWasInMenu) {
            toggle.focus();
          }
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.cleanup?.abort();
    }
  }

  if (!customElements.get("attorneys-nav")) {
    customElements.define("attorneys-nav", AttorneysNav);
  }
</script>