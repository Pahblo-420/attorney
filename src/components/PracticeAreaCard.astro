---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<!-- Added 'h-full' to ensure cards in the same row stretch to match heights -->
<a
  href={href}
  class="practice-card reveal-on-scroll group relative flex h-full flex-col justify-between rounded-lg border border-stone/50 bg-white p-8 opacity-0 shadow-sm transition-all duration-700 ease-out translate-y-8 hover:-translate-y-2 hover:border-[#D4AF67] hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 motion-reduce:transform-none motion-reduce:opacity-100"
>
  <div>
    <!-- Added 'card-icon' class for mobile targeting -->
    <div class="card-icon mb-6 inline-flex h-14 w-14 items-center justify-center rounded-md bg-navy/5 text-navy transition-colors duration-500 group-hover:bg-navy group-hover:text-[#E8CA90]">
      <slot name="icon" />
    </div>
    
    <!-- Added 'card-title' class for mobile targeting -->
    <h3 class="card-title font-serif text-xl font-semibold text-navy transition-colors duration-300 group-hover:text-navy/80">
      {title}
    </h3>
    
    <p class="mt-3 text-sm leading-relaxed text-slate">
      {description}
    </p>
  </div>

  <!-- Added 'card-cta' and 'card-arrow' classes for mobile targeting -->
  <div class="card-cta mt-8 flex items-center text-sm font-semibold text-navy transition-colors duration-300 group-hover:text-[#D4AF67]">
    Learn more
    <svg 
      class="card-arrow ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" 
      fill="none" 
      viewBox="0 0 24 24" 
      stroke="currentColor" 
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
    </svg>
  </div>
</a>

<style>
  /* Mobile Scroll "Hover" Simulation */
  /* Only applies to small screens (phones) */
  @media (max-width: 639px) { 
    .practice-card.is-active {
      transform: translateY(-0.5rem);
      border-color: #D4AF67;
      box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    }
    .practice-card.is-active .card-icon {
      background-color: #0A192F; /* navy */
      color: #E8CA90; /* gold */
    }
    .practice-card.is-active .card-title {
      color: rgba(10, 25, 47, 0.8); /* navy/80 */
    }
    .practice-card.is-active .card-cta {
      color: #D4AF67; /* gold */
    }
    .practice-card.is-active .card-arrow {
      transform: translateX(0.375rem);
    }
  }
</style>