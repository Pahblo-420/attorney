---
interface Props {
  phone?: string;
  email?: string;
  bailPhone?: string;
  streetAddress?: string;
  officeHours?: string;
}

// Added default fallback values so these always render
const {
  phone = "0800 123 4567",
  email = "info@pahblos.co.za",
  bailPhone = "0800 123 4567",
  streetAddress = "123 Nelson Mandela Drive",
  officeHours = "Monday - Friday: 08:00 - 16:30\nWeekends & Public Holidays: Closed",
} = Astro.props;

const year = new Date().getFullYear();

const telephoneHref = (number: string) =>
  `tel:${number.replace(/[^\d+]/g, "")}`;

const navigation = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About the Firm" },
  { href: "/practice-areas", label: "Practice Areas" },
  { href: "/our-attorneys", label: "Our Attorneys" },
  { href: "/insights", label: "Insights / FAQs" },
  { href: "/contact", label: "Contact" },
];

const practiceAreas = [
  { href: "/practice-areas/civil-litigation", label: "Civil Litigation" },
  { href: "/practice-areas/contract-law", label: "Contract Law" },
  { href: "/practice-areas/divorce", label: "Divorce" },
  { href: "/practice-areas/labour-disputes", label: "Labour Disputes" },
  { href: "/practice-areas/debt-collection", label: "Debt Collection" },
  { href: "/practice-areas/immigration-law", label: "Immigration Law" },
  { href: "/practice-areas/insolvency-business-rescue", label: "Insolvency & Business Rescue" },
  { href: "/practice-areas/conveyancing-property-law", label: "Conveyancing & Property Law" },
  { href: "/practice-areas/criminal-litigation-bail", label: "Criminal Litigation & Bail" },
  { href: "/practice-areas/deceased-estates", label: "Deceased Estates" },
  { href: "/practice-areas/wills", label: "Wills" },
  { href: "/practice-areas/road-accident-fund", label: "Road Accident Fund Claims" },
];

// Limit to 5 practice areas as requested
const topPracticeAreas = practiceAreas.slice(0, 5);

const linkStyles =
  "inline-flex min-h-9 items-center rounded-sm text-sm text-white/70 underline-offset-4 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transition-none";
---

<footer class="relative bg-navy">
  <!-- Glowing Gold Divider Line -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#D4AF67] to-transparent"></div>
  <div class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    
    <div class="grid gap-12 pb-16 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.5fr] lg:gap-8">
      
      <!-- Firm identity & Socials -->
      <div class="lg:pr-8">
        <a
          href="/"
          aria-label="Pahblo’s Attorneys — home"
          class="inline-flex rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-4 focus-visible:ring-offset-navy"
        >
          <img
            src="/images/pahblo_attorneys_logo.webp"
            alt="Pahblo’s Attorneys"
            width="180"
            height="120"
            loading="lazy"
            decoding="async"
            class="h-24 w-auto object-contain brightness-0 invert" 
          />
        </a>

        <p class="mt-6 max-w-xs text-sm leading-relaxed text-white/70">
          Legal advice and representation for individuals, families
          and businesses. Based in Phuthaditjhaba, QwaQwa.
        </p>

        <!-- Brand-colored Social Icons -->
        <div class="mt-8 flex items-center gap-5">
          <!-- Facebook (#1877F2) -->
          <a href="#" aria-label="Facebook" class="text-[#1877F2] transition-transform hover:-translate-y-1 hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <!-- Instagram (Brand Pink #E1306C) -->
          <a href="#" aria-label="Instagram" class="text-[#E1306C] transition-transform hover:-translate-y-1 hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
          </a>
          <!-- X (White for dark mode) -->
          <a href="#" aria-label="X (Twitter)" class="text-white transition-transform hover:-translate-y-1 hover:text-gray-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
            <svg class="h-[1.15rem] w-[1.15rem]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" />
            </svg>
          </a>
          <!-- WhatsApp (#25D366) -->
          <a href="#" aria-label="WhatsApp" class="text-[#25D366] transition-transform hover:-translate-y-1 hover:brightness-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.031 2c-5.518 0-9.998 4.48-9.998 9.998 0 1.968.558 3.882 1.597 5.512L2 22l4.632-1.574c1.554.912 3.328 1.401 5.187 1.401h.004c5.517 0 9.997-4.48 9.997-9.999C21.82 6.31 17.433 2 12.031 2zm0 18.042c-1.637 0-3.237-.44-4.638-1.27l-.333-.198-3.447 1.171 1.206-3.364-.217-.346C3.785 14.654 3.313 13.067 3.313 11.4c0-4.82 3.921-8.742 8.741-8.742 4.819 0 8.74 3.922 8.74 8.743 0 4.82-3.922 8.74-8.742 8.74h-.021zm4.793-6.544c-.262-.132-1.554-.768-1.794-.856-.24-.088-.415-.132-.59.132-.175.263-.679.856-.832 1.032-.153.175-.306.198-.568.066-.262-.132-1.111-.41-2.115-1.304-.78-.696-1.306-1.556-1.46-1.819-.153-.263-.016-.405.115-.536.118-.118.262-.307.394-.46.131-.154.175-.263.262-.439.088-.175.044-.329-.022-.46-.066-.132-.59-1.424-.809-1.948-.213-.513-.429-.444-.59-.452-.153-.007-.329-.007-.504-.007-.175 0-.46.066-.7.329-.24.263-.918.899-.918 2.191 0 1.292.94 2.542 1.071 2.718.131.176 1.854 2.827 4.49 3.961 2.635 1.134 2.635.756 3.116.712.482-.044 1.554-.635 1.773-1.25.219-.613.219-1.14.153-1.25-.065-.111-.24-.176-.503-.308z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Main navigation -->
      <nav aria-labelledby="footer-navigation-heading">
        <h2 id="footer-navigation-heading" class="font-serif text-lg font-semibold tracking-wide text-[#D4AF67]">
          Explore
        </h2>

        <ul class="mt-6 space-y-1">
          {
            navigation.map(({ href, label }) => (
              <li>
                <a href={href} class={linkStyles}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Practice-area navigation (Truncated to 5) -->
      <nav aria-labelledby="footer-practices-heading">
        <h2 id="footer-practices-heading" class="font-serif text-lg font-semibold tracking-wide text-[#D4AF67]">
          Practice Areas
        </h2>

        <ul class="mt-6 space-y-1">
          {
            topPracticeAreas.map(({ href, label }) => (
              <li>
                <a href={href} class={linkStyles}>
                  {label}
                </a>
              </li>
            ))
          }
          <!-- See More Link -->
          <li class="pt-2">
            <a href="/practice-areas" class="group inline-flex items-center text-sm font-semibold text-[#D4AF67] transition-colors hover:text-[#E8CA90] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
              See all areas 
              <span aria-hidden="true" class="ml-1 transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Contact information (Now guaranteed to render) -->
      <div>
        <h2 class="font-serif text-lg font-semibold tracking-wide text-[#D4AF67]">
          Get in Touch
        </h2>

        <address class="mt-6 space-y-4 text-sm leading-relaxed text-white/70 not-italic">
          <p>
            <span class="block text-white/90">{streetAddress}</span>
            <span class="block">Phuthaditjhaba, QwaQwa</span>
            <span class="block">South Africa</span>
          </p>

          <p>
            <a href={telephoneHref(phone)} class={linkStyles}>
              {phone}
            </a>
          </p>

          <p>
            <a href={`mailto:${email}`} class:list={[linkStyles, "break-all"]}>
              {email}
            </a>
          </p>
        </address>

        <div class="mt-6">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-white/50">
            Office Hours
          </h3>
          <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-white/70">
            {officeHours}
          </p>
        </div>

        <a href="/contact" class:list={[linkStyles, "mt-4 font-semibold text-white"]}>
          Contact the Firm
          <span aria-hidden="true" class="ml-2 text-[#D4AF67]">→</span>
        </a>
      </div>
    </div>

    <!-- General information notice -->
    <div class="border-t border-white/10 py-8">
      <p class="max-w-4xl text-xs leading-relaxed text-white/50">
        Website content provides general information and does not replace
        advice on your particular circumstances. Sending an enquiry does
        not appoint the firm to act on your behalf.
      </p>
    </div>

    <!-- Copyright, Policy, and Attribution -->
    <div class="flex flex-col gap-6 border-t border-white/10 py-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-col gap-2">
        <p class="text-xs text-white/50">
          © {year} Pahblo’s Attorneys. All rights reserved.
        </p>
        <!-- TechPoint Web Signature -->
        <p class="text-xs text-white/40">
          Engineered by <a href="https://techpointweb.co.za" target="_blank" rel="noopener noreferrer" class="font-semibold text-white/60 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-2 focus-visible:ring-offset-navy">TechPoint Web</a>
        </p>
      </div>

      <nav aria-label="Website policies">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            <a href="/privacy" class="text-xs text-white/50 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
              Privacy Notice
            </a>
          </li>
          <li>
            <a href="/disclaimer" class="text-xs text-white/50 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#D4AF67] focus-visible:ring-offset-4 focus-visible:ring-offset-navy">
              Website Disclaimer
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>