---
interface Props {
  bailPhone?: string;
}

const { bailPhone } = Astro.props;
const bailPhoneHref = bailPhone?.replace(/[^\d+]/g, "");

// Added `w-full sm:w-auto` so the buttons stretch to match widths on mobile, but wrap normally on desktop
const buttonStyles =
  "inline-flex w-full sm:w-auto min-h-12 items-center justify-center gap-2 rounded-sm px-6 py-3 text-sm font-semibold transition duration-200 ease-out hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none motion-reduce:transition-none";
---

<section
  aria-labelledby="hero-heading"
  class="relative isolate flex min-h-[100dvh] w-full items-center overflow-hidden bg-navy text-white"
>
  <!-- Background photograph -->
  <img
    src="/images/hero.webp"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    loading="eager"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[65%_center] lg:object-center"
  />

  <!-- Contrast overlay -->
  <div
    aria-hidden="true"
    class="hero-overlay absolute inset-0 -z-10"
  ></div>

  <!-- Main Content -->
  <div class="mx-auto w-full max-w-7xl px-4 pt-28 sm:px-6 sm:pt-32 lg:px-8">
    <div class="max-w-2xl">
      <!-- Brand introduction - margin reduced to mb-4 -->
      <div class="mb-4 flex items-center gap-3">
        <span
          aria-hidden="true"
          class="h-px w-10 shrink-0 bg-[#D4AF67]"
        ></span>

        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-[#E8CA90] sm:text-sm"
        >
          Pahblo’s Attorneys
        </p>
      </div>

      <!-- Heading - reduced to text-[3.5rem] and leading-[1.1] -->
      <h1
        id="hero-heading"
        class="text-balance font-serif text-4xl leading-[1.1] tracking-tight sm:text-5xl lg:text-[3.5rem]"
      >
        Legal support for life, business and everything at stake.
      </h1>

      <!-- Paragraph - top margin reduced to mt-4 -->
      <p
        class="mt-4 max-w-xl text-pretty text-base leading-relaxed text-white/90 sm:text-lg"
      >
        From family and property matters to workplace disputes and litigation,
        we provide clear advice and dedicated representation to help you
        move forward.
      </p>

      <!-- Buttons - top margin reduced to mt-8 -->
      <div class="mt-8 flex justify-center sm:justify-start">
        <div class="grid w-fit gap-4 sm:flex sm:flex-row sm:flex-wrap">
          <a
            href="/contact#consultation"
            class:list={[
              buttonStyles,
              "border border-[#D4AF67] bg-[#D4AF67] text-navy hover:border-[#E8CA90] hover:bg-[#E8CA90]",
            ]}
          >
            Book a Consultation

            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>

          <a
            href="#practice-areas"
            class:list={[
              buttonStyles,
              "border border-white/70 bg-transparent text-white hover:border-white hover:bg-white/10",
            ]}
          >
            Explore Practice Areas
          </a>
        </div>
      </div>

      <!-- Optional urgent bail contact - margin reduced to mt-6, pt-4 -->
      {
        bailPhone && bailPhoneHref && (
          <div class="mt-6 border-t border-white/20 pt-4 text-center sm:text-left">
            <p class="text-sm text-white/80">
              Need urgent bail assistance?
            </p>

            <a
              href={`tel:${bailPhoneHref}`}
              class="mt-1 inline-flex min-h-11 items-center gap-2 rounded-sm text-sm font-semibold text-[#E8CA90] underline-offset-4 transition-colors hover:text-white hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transition-none"
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.57 2.79.7A2 2 0 0 1 22 16.92z"></path>
              </svg>

              <span>24-hour bail assistance · {bailPhone}</span>
            </a>
          </div>
        )
      }
    </div>
  </div>

  <!-- Animated Scroll Down Chevrons - Reduced size and margin on mobile -->
  <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 flex-col items-center -space-y-2 pointer-events-none sm:bottom-8 sm:-space-y-3">
    <svg class="chevron-animate chevron-delay-1 h-6 w-6 text-[#E8CA90] sm:h-8 sm:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
    <svg class="chevron-animate chevron-delay-2 h-6 w-6 text-[#E8CA90] sm:h-8 sm:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
    <svg class="chevron-animate chevron-delay-3 h-6 w-6 text-[#E8CA90] sm:h-8 sm:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </div>
</section>

<style>
  .hero-overlay {
    background: linear-gradient(
      90deg,
      rgb(10 25 47 / 96%) 0%,
      rgb(10 25 47 / 90%) 45%,
      rgb(10 25 47 / 65%) 75%,
      rgb(10 25 47 / 45%) 100%
    );
  }

  /* Chevron Animation Logic */
  @keyframes lightUp {
    0% { opacity: 0.15; }
    30% { opacity: 1; }
    60%, 100% { opacity: 0.15; }
  }

  .chevron-animate {
    animation: lightUp 1.5s infinite;
  }
  
  .chevron-delay-1 {
    animation-delay: 0s;
  }
  .chevron-delay-2 {
    animation-delay: 0.2s;
  }
  .chevron-delay-3 {
    animation-delay: 0.4s;
  }

  @media (max-width: 639px) {
    .hero-overlay {
      background: rgb(10 25 47 / 88%);
    }
  }
</style>