<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Reveal on scroll animation for vertical flow
    const revealOptions = {
      root: null,
      rootMargin: "0px 0px -50px 0px",
      threshold: 0.1,
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add("opacity-100", "translate-y-0");
          observer.unobserve(entry.target);
        }
      });
    }, revealOptions);

    const cards = document.querySelectorAll(".reveal-on-scroll");
    cards.forEach((card, index) => {
      if (!(card as HTMLElement).style.transitionDelay) {
        const delay = (index % 3) * 150; 
        (card as HTMLElement).style.transitionDelay = `${delay}ms`;
      }
      revealObserver.observe(card);
    });

    // 2. Horizontal Center Focus for the Logo Track
    const horizontalFocusOptions = {
      root: null,
      rootMargin: "0px -40% 0px -40%", // Narrows horizontal window
      threshold: 0,
    };

    const horizontalObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-active", "true");
        } else {
          entry.target.removeAttribute("data-active");
        }
      });
    }, horizontalFocusOptions);

    const logoCards = document.querySelectorAll(".client-logo");
    logoCards.forEach((card) => horizontalObserver.observe(card));


    // 3. Vertical Center Focus for Mobile Interactive Cards (The Fix)
    const verticalFocusOptions = {
      root: null,
      rootMargin: "-40% 0px -40% 0px", // Narrows vertical window to the middle 20% of the screen
      threshold: 0,
    };

    const verticalObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.setAttribute("data-active", "true");
        } else {
          entry.target.removeAttribute("data-active");
        }
      });
    }, verticalFocusOptions);

    const interactiveCards = document.querySelectorAll(".mobile-interactive");
    interactiveCards.forEach((card) => verticalObserver.observe(card));


    // 4. Infinite Auto-Scroll Logic for Logos
    const track = document.getElementById("logo-track");
    if (track) {
      let scrollPos = 0;
      let isPaused = false;

      // Pause on hover
      track.addEventListener("mouseenter", () => (isPaused = true));
      track.addEventListener("mouseleave", () => (isPaused = false));

      const animateScroll = () => {
        if (!isPaused) {
          scrollPos += 0.75; // Adjust speed here
          if (scrollPos >= track.scrollWidth / 2) {
            scrollPos = 0;
          }
          track.style.transform = `translateX(-${scrollPos}px)`;
        }
        requestAnimationFrame(animateScroll);
      };
      
      requestAnimationFrame(animateScroll);
    }
  });
</script>