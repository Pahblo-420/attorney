---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Civil Litigation Attorneys in Phuthaditjhaba | Pahblo’s Attorneys"
  description="Pahblo's Attorneys assists individuals and businesses with civil disputes in Phuthaditjhaba, QwaQwa."
>
  <!-- Premium Hero Section -->
  <section
    aria-labelledby="civil-litigation-heading"
    class="relative isolate overflow-hidden bg-navy text-white pb-16 pt-32 sm:pb-20 sm:pt-40 lg:pb-24 lg:pt-44"
  >
    <!-- Cinematic background Image -->
    <img
      src="/images/about_firm2.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center opacity-80"
    />

    <!-- Contrast overlay via CSS class -->
    <div
      aria-hidden="true"
      class="practice-overlay absolute inset-0 -z-10"
    ></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
        <!-- Breadcrumb -->
        
        <div class="max-w-3xl">
          <div class="mb-5 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-px w-10 shrink-0 bg-[#D4AF67]"
            ></span>

            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-[#E8CA90]"
            >
              Civil Disputes & Representation
            </p>
          </div>

          <h1
            id="civil-litigation-heading"
            class="text-balance font-serif text-4xl leading-tight sm:text-5xl lg:text-6xl"
          >
            Civil Litigation Attorneys in Phuthaditjhaba
          </h1>

          <p
            class="mt-6 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg"
          >
            When a dispute affects your finances, business or personal
            interests, understanding your options is an important first
            step. Pahblo’s Attorneys assists individuals and businesses
            with civil disputes from our base in Phuthaditjhaba, QwaQwa.
          </p>

          <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#D4AF67]">
            Contact us to discuss your circumstances, the documents
            relevant to your matter and the assistance you may need.
          </p>

          <a
            href="/contact#consultation"
            class="group mt-10 inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-[#D4AF67] px-8 py-3.5 text-sm font-semibold text-navy shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-[#E8CA90] hover:shadow-xl hover:shadow-[#D4AF67]/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none"
          >
            Discuss Your Civil Matter

            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How the firm assists -->
  <section
    aria-labelledby="civil-assistance-heading"
    class="bg-white py-16 sm:py-24 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <div class="mb-5 flex items-center gap-3">
            <span aria-hidden="true" class="h-px w-10 shrink-0 bg-[#D4AF67]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
              How We Assist
            </p>
          </div>

          <h2
            id="civil-assistance-heading"
            class="text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl"
          >
            Understanding your dispute and the way forward.
          </h2>

          <p class="mt-6 text-lg leading-relaxed text-slate">
            A disagreement can place pressure on your finances, relationships
            or business operations. We begin by understanding what happened,
            what is at stake and the outcome you are seeking.
          </p>
        </div>

        <div class="reveal-on-scroll space-y-6 text-base leading-relaxed text-slate opacity-0 translate-y-8 transition-all duration-1000 ease-out" style="transition-delay: 200ms;">
          <p>
            Pahblo’s Attorneys assists individuals and businesses with civil
            disputes in Phuthaditjhaba, QwaQwa. A consultation gives us an
            opportunity to consider your circumstances and the information
            available before discussing an appropriate approach.
          </p>

          <p>
            Relevant information may include agreements, correspondence,
            payment records and documents received from another party.
            Reviewing this material helps identify the issues requiring
            attention and any further information needed.
          </p>

          <p>
            We discuss the assistance proposed for your matter, including
            its scope, fees and communication arrangements. Where further
            work is agreed, the approach will depend on your circumstances
            and the requirements of the matter.
          </p>
        </div>
      </div>

      <!-- Common concerns Grid -->
      <div class="mt-20 border-t border-stone-200 pt-16">
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <h3 class="font-serif text-2xl text-navy">
            Situations you can discuss with us
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-slate">
            Tell us about any dates or deadlines shown on documents when
            you first contact the firm.
          </p>
        </div>

        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:gap-8">
          {
            [
              {
                title: "A dispute involving money",
                description:
                  "You disagree about an amount claimed, a payment made or a financial obligation.",
              },
              {
                title: "A disagreement affecting your business",
                description:
                  "A dispute with another party is affecting your commercial interests or operations.",
              },
              {
                title: "A dispute involving personal interests",
                description:
                  "You need advice about a disagreement affecting your personal rights or interests.",
              },
              {
                title: "Documents received from another party",
                description:
                  "You have received a demand, claim or court document and need advice about your response.",
              },
            ].map(({ title, description }, index) => (
              <li 
                class="reveal-on-scroll group rounded-2xl border border-stone-100 bg-stone-50 p-8 shadow-sm opacity-0 translate-y-8 transition-all duration-700 ease-out hover:-translate-y-1 hover:border-[#D4AF67]/40 hover:bg-white hover:shadow-xl hover:shadow-navy/5"
                style={`transition-delay: ${index * 100}ms;`}
              >
                <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-navy/5 text-navy group-hover:bg-[#D4AF67]/10 group-hover:text-[#D4AF67] transition-colors">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h4 class="font-serif text-xl font-semibold text-navy">
                  {title}
                </h4>
                <p class="mt-3 text-sm leading-relaxed text-slate">
                  {description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section
    aria-labelledby="civil-process-heading"
    class="bg-stone-50 py-16 sm:py-24 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="reveal-on-scroll max-w-2xl opacity-0 translate-y-8 transition-all duration-1000 ease-out">
        <p
          class="text-xs font-semibold uppercase tracking-[0.2em] text-navy"
        >
          What to Expect
        </p>

        <h2
          id="civil-process-heading"
          class="mt-4 text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl"
        >
          A considered approach to your civil matter.
        </h2>

        <p class="mt-6 text-lg leading-relaxed text-slate">
          Every dispute is different. These steps outline how we begin
          working with you; the subsequent process depends on the matter.
        </p>
      </div>

      <ol class="mt-16 grid gap-12 lg:grid-cols-3 lg:gap-16">
        {
          [
            {
              number: "01",
              title: "Discuss the circumstances",
              description:
                "Explain the dispute, the parties involved, important dates and the outcome you would like to achieve.",
            },
            {
              number: "02",
              title: "Review information and options",
              description:
                "We consider the relevant documents, identify information still needed and discuss possible approaches and their implications.",
            },
            {
              number: "03",
              title: "Agree the next steps",
              description:
                "Confirm the proposed scope of work, fees and responsibilities. Once appointed, we keep you informed as the agreed work progresses.",
            },
          ].map(({ number, title, description }, index) => (
            <li 
              class="reveal-on-scroll relative border-t-2 border-stone-200 pt-8 opacity-0 translate-y-8 transition-all duration-700 ease-out before:absolute before:left-0 before:top-[-2px] before:h-[2px] before:w-12 before:bg-[#D4AF67] before:transition-all before:duration-700 hover:before:w-full"
              style={`transition-delay: ${index * 150}ms;`}
            >
              <span
                aria-hidden="true"
                class="block font-serif text-4xl font-bold text-[#D4AF67]/30 transition-colors duration-300 hover:text-[#D4AF67]"
              >
                {number}
              </span>

              <h3 class="mt-5 font-serif text-2xl text-navy">
                {title}
              </h3>

              <p class="mt-4 leading-relaxed text-slate">
                {description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Consultation preparation -->
  <section
    aria-labelledby="civil-preparation-heading"
    class="bg-white py-16 sm:py-24 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <div class="mb-5 flex items-center gap-3">
            <span aria-hidden="true" class="h-px w-10 shrink-0 bg-[#D4AF67]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
              Preparing for Your Consultation
            </p>
          </div>

          <h2
            id="civil-preparation-heading"
            class="mt-4 text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl"
          >
            Bring the information that tells your story.
          </h2>

          <p class="mt-6 text-lg leading-relaxed text-slate">
            Organised information helps make your appointment useful.
            Ask us which documents are needed for your particular dispute
            and how to provide them.
          </p>

          <a
            href="/insights/preparing-for-your-first-attorney-consultation"
            class="group mt-8 inline-flex min-h-12 items-center gap-2 rounded-sm text-sm font-semibold text-navy underline-offset-4 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4"
          >
            Read our consultation preparation guide
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>

        <div 
          class="reveal-on-scroll rounded-2xl border border-stone-100 bg-stone-50 p-8 shadow-sm opacity-0 translate-y-8 transition-all duration-1000 ease-out sm:p-10"
          style="transition-delay: 200ms;"
        >
          <h3 class="font-serif text-2xl text-navy">
            A useful starting checklist
          </h3>

          <ul class="mt-6 space-y-4 text-base leading-relaxed text-slate">
            {
              [
                "A short timeline of events and important dates.",
                "Names and contact details of the parties involved.",
                "Relevant agreements and correspondence.",
                "Invoices, receipts or payment records, where relevant.",
                "Any demands, claims or court documents received.",
                "Your questions and the outcome you are seeking.",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-1 h-5 w-5 shrink-0 text-[#D4AF67]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>

          <p class="mt-8 border-t border-stone-200 pt-6 text-sm leading-relaxed text-slate/80">
            Keep original documents safe. Use the website form for a brief
            enquiry and confirm an appropriate way to share sensitive
            documents with the firm.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service-specific FAQs -->
  <section
    aria-labelledby="civil-faq-heading"
    class="bg-stone-50 py-16 sm:py-24 lg:py-32"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <div class="mb-5 flex items-center gap-3">
            <span aria-hidden="true" class="h-px w-10 shrink-0 bg-[#D4AF67]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
              Civil Litigation FAQs
            </p>
          </div>

          <h2
            id="civil-faq-heading"
            class="font-serif text-3xl leading-tight text-navy sm:text-4xl"
          >
            Questions about your dispute.
          </h2>

          <p class="mt-6 text-lg leading-relaxed text-slate">
            These answers help you prepare for a discussion. Advice on
            your particular matter requires consideration of its facts.
          </p>
        </div>

        <div class="space-y-4">
          {
            [
              {
                question: "Can I consult the firm if I have received a claim?",
                answer:
                  "Yes. Contact us with a brief description of what you received and mention any dates shown on the documents. Ask how to provide the complete documents for review.",
              },
              {
                question: "What if I am unsure whether my matter is civil litigation?",
                answer:
                  "Explain your circumstances when making an enquiry. We can discuss whether the matter fits this practice area or another service offered by the firm.",
              },
              {
                question: "How long will my matter take?",
                answer:
                  "We cannot give a reliable estimate without understanding the matter. Ask about the factors that may affect progress and how updates will be communicated.",
              },
              {
                question: "What will legal assistance cost?",
                answer:
                  "Confirm the consultation fee before your appointment. Any further work should be discussed separately, including its scope, how fees are calculated and anticipated additional costs.",
              },
              {
                question: "Can you guarantee a particular outcome?",
                answer:
                  "No outcome can be promised. A consultation helps you discuss the available information, uncertainties and possible approaches before deciding on your next steps.",
              },
            ].map(({ question, answer }, index) => (
              <details 
                class="reveal-on-scroll group rounded-xl border border-stone-200 bg-white opacity-0 translate-y-8 transition-all duration-500 ease-out hover:border-[#D4AF67]/50 hover:shadow-md open:border-[#D4AF67] open:shadow-md open:ring-1 open:ring-[#D4AF67]/20"
                style={`transition-delay: ${index * 100}ms;`}
              >
                <summary class="flex min-h-[4.5rem] cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-semibold text-navy transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2 group-open:text-[#D4AF67]">
                  <span class="pr-4">{question}</span>

                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-navy/5 text-navy transition-colors group-open:bg-[#D4AF67]/10 group-open:text-[#D4AF67]">
                    <svg
                      aria-hidden="true"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      class="transition-transform duration-300 group-open:rotate-180"
                    >
                      <path d="M5 12h14" />
                      <path d="M12 5v14" class="group-open:hidden" />
                    </svg>
                  </div>
                </summary>

                <div class="px-6 pb-6 pt-2">
                  <p class="text-base leading-relaxed text-slate">
                    {answer}
                  </p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Related services & CTA Container -->
  <div class="bg-white">
    <section
      aria-labelledby="related-services-heading"
      class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8"
    >
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
        <h2
          id="related-services-heading"
          class="font-serif text-2xl text-navy"
        >
          Related practice areas
        </h2>

        <ul class="mt-6 flex flex-wrap gap-4">
          {
            [
              { href: "/practice-areas/contract-law", label: "Contract Law" },
              { href: "/practice-areas/debt-collection", label: "Debt Collection" },
              { href: "/practice-areas/labour-disputes", label: "Labour Disputes" },
            ].map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="group inline-flex min-h-12 items-center gap-2 rounded-full border border-stone-200 bg-white px-6 py-3 text-sm font-semibold text-navy shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-[#D4AF67]/50 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-2"
                >
                  {label}
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1 text-[#D4AF67]">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Consultation CTA -->
    <section
      aria-labelledby="civil-consultation-heading"
      class="relative isolate overflow-hidden bg-navy py-16 text-white sm:py-24"
    >
      <!-- Subtle golden background glow -->
      <div class="absolute right-0 top-1/2 -z-10 h-[400px] w-[400px] -translate-y-1/2 translate-x-1/4 rounded-full bg-[#D4AF67]/15 blur-[100px]"></div>

      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="reveal-on-scroll flex flex-col gap-8 opacity-0 translate-y-8 transition-all duration-1000 ease-out lg:flex-row lg:items-center lg:justify-between lg:gap-16">
          <div class="max-w-2xl">
            <h2
              id="civil-consultation-heading"
              class="text-balance font-serif text-3xl leading-tight sm:text-4xl lg:text-5xl"
            >
              Let’s discuss your civil dispute.
            </h2>

            <p class="mt-6 text-base leading-relaxed text-white/80 sm:text-lg">
              Contact Pahblo’s Attorneys in Phuthaditjhaba, QwaQwa,
              to enquire about a consultation and your next steps.
            </p>
          </div>

          <a
            href="/contact#consultation"
            class="group inline-flex min-h-12 shrink-0 items-center justify-center gap-2 self-start rounded-sm bg-[#D4AF67] px-8 py-4 text-sm font-semibold text-navy shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-[#E8CA90] hover:shadow-xl hover:shadow-[#D4AF67]/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none lg:self-auto"
          >
            Discuss Your Matter
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1">
              <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hides the default browser arrow on details/summary elements */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Desktop Gradient: Dark enough to hide complex background details behind the text */
  .practice-overlay {
    background: linear-gradient(
      90deg,
      rgb(10 25 47 / 96%) 0%,
      rgb(10 25 47 / 90%) 35%,
      rgb(10 25 47 / 70%) 65%,
      rgb(10 25 47 / 45%) 100%
    );
  }

  /* Mobile Background: A solid, deep navy for perfect readability */
  @media (max-width: 639px) {
    .practice-overlay {
      background: rgb(10 25 47 / 92%);
    }
  }
</style>

<script>
  // Intersection Observer to handle the reveal-on-scroll animations
  document.addEventListener("DOMContentLoaded", () => {
    const revealOptions = {
      root: null,
      rootMargin: "0px 0px -50px 0px",
      threshold: 0.1,
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add("opacity-100", "translate-y-0");
          observer.unobserve(entry.target);
        }
      });
    }, revealOptions);

    const elementsToReveal = document.querySelectorAll(".reveal-on-scroll");
    elementsToReveal.forEach((el) => revealObserver.observe(el));
  });
</script>