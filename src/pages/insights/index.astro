---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { insights } from "../../data/insights";

const formatArticleDate = (date: string) =>
  new Intl.DateTimeFormat("en-ZA", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
---

<BaseLayout 
  title="Legal Insights | Pahblo's Attorneys" 
  description="Explore practical introductions to common legal matters and prepare for professional advice in South Africa."
>
  <section class="bg-stone-50 pb-20 pt-32 sm:pb-24 sm:pt-40 lg:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <div class="mb-5 flex items-center gap-3">
          <span aria-hidden="true" class="h-px w-10 bg-[#D4AF67]"></span>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">Legal Insights</p>
        </div>
        <h1 class="font-serif text-4xl leading-tight text-navy sm:text-5xl lg:text-6xl">
          Information for your next step.
        </h1>
        <p class="mt-6 text-base leading-relaxed text-slate sm:text-lg">
          Explore practical introductions to common legal matters and preparing for professional advice.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          insights.map((article) => (
            <article class="group relative flex flex-col rounded-2xl bg-white p-8 shadow-md transition-all duration-700 ease-out hover:-translate-y-2 hover:shadow-xl">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#D4AF67]">{article.category}</p>
              <h2 class="mt-4 font-serif text-2xl leading-snug text-navy transition-colors duration-300 group-hover:text-navy/80">
                <a href={`/insights/${article.slug}`} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4">
                  <span class="absolute inset-0" aria-hidden="true"></span>
                  {article.title}
                </a>
              </h2>
              <time datetime={article.date} class="mt-3 text-xs text-slate">{formatArticleDate(article.date)}</time>
              <p class="mt-4 text-sm leading-relaxed text-slate">{article.summary}</p>
              <div class="mt-auto flex items-center pt-8 text-sm font-semibold text-navy transition-colors duration-300 group-hover:text-[#D4AF67]">
                Read Article
                <svg class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>