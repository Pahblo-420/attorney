---
import BaseLayout from "../layouts/BaseLayout.astro";

// Pre-filled realistic data for Pahblo's Attorneys
const contact = {
  phone: "+27 58 713 0001",
  bailPhone: "+27 58 713 0005",
  email: "info@pahblosattorneys.co.za",
  streetAddress: "Suite 4, Setsing Business Centre",
  officeHours: "Monday – Friday: 08:00 – 16:30\nWeekends & Public Holidays: Closed (Except for Bail Emergencies)",
};

const formEndpoint = ""; // Your form submission endpoint

const mapLocation = contact.streetAddress
  ? `${contact.streetAddress}, Phuthaditjhaba, QwaQwa, South Africa`
  : "Phuthaditjhaba, QwaQwa, South Africa";

const mapQuery = encodeURIComponent(mapLocation);

const practiceAreas = [
  "Civil Litigation",
  "Contract Law",
  "Divorce",
  "Labour Disputes",
  "Debt Collection",
  "Immigration Law",
  "Insolvency & Business Rescue",
  "Conveyancing & Property Law",
  "Criminal Litigation & Bail Applications",
  "Deceased Estates",
  "Wills",
  "Road Accident Fund Claims",
  "Not sure",
];

const fieldStyles =
  "mt-2 block min-h-12 w-full rounded-md border border-stone-200 bg-stone-50/50 px-4 py-3 text-base text-navy placeholder:text-slate/50 transition-all duration-300 focus:border-[#D4AF67] focus:bg-white focus:outline-none focus:ring-4 focus:ring-[#D4AF67]/10 hover:border-stone-300";
---

<BaseLayout 
  title="Contact Us | Pahblo’s Attorneys"
  description="Contact Pahblo's Attorneys in Phuthaditjhaba, QwaQwa for legal consultations and 24-hour bail assistance."
>
  <!-- 1. HERO SECTION -->
  <section
    aria-labelledby="contact-heading"
    class="relative isolate overflow-hidden bg-navy text-white"
  >
    <!-- Cinematic background Image -->
    <img
      src="/images/contact.webp"
      alt=""
      aria-hidden="true"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />

    <!-- Contrast overlay via CSS class -->
    <div
      aria-hidden="true"
      class="contact-overlay absolute inset-0 -z-10"
    ></div>

    <div
      class="mx-auto flex min-h-[32rem] max-w-7xl flex-col justify-center px-4 pb-16 pt-28 sm:px-6 sm:pb-20 sm:pt-32 lg:min-h-[38rem] lg:px-8 lg:pt-36"
    >
      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
        
        <div class="max-w-2xl">
          <div class="mb-5 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-px w-10 shrink-0 bg-[#D4AF67]"
            ></span>

            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-[#E8CA90]"
            >
              Get in Touch
            </p>
          </div>

          <h1
            id="contact-heading"
            class="text-balance font-serif text-4xl leading-tight sm:text-5xl lg:text-6xl"
          >
            Contact Pahblo’s Attorneys
          </h1>

          <p
            class="mt-6 font-serif text-xl leading-relaxed text-[#D4AF67] sm:text-2xl"
          >
            Here to assist. Reach out to discuss your matter.
          </p>

          <p
            class="mt-6 max-w-xl text-base leading-relaxed text-white/80 sm:text-lg"
          >
            Have a legal matter you would like to discuss? Contact our firm
            in Phuthaditjhaba, QwaQwa, to enquire about a consultation
            and your next steps.
          </p>

          <!-- Action Buttons -->
          <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
            <a
              href="#consultation"
              class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-[#D4AF67] px-8 py-3 text-sm font-semibold text-navy shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-[#E8CA90] hover:shadow-xl hover:shadow-[#D4AF67]/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none"
            >
              Enquire About a Consultation

              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="transition-transform duration-300 group-hover:translate-x-1"
              >
                <path d="M5 12h14m-6-6 6 6-6 6"></path>
              </svg>
            </a>

            <!-- Urgent 24h Action Button -->
            <a
              href="#bail-assistance"
              class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-sm border border-white/20 bg-white/5 px-8 py-3 text-sm font-semibold text-white transition-all duration-300 ease-out hover:-translate-y-1 hover:border-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none"
            >
              24-Hour Bail Assistance
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. CONSULTATION & CONTACT DETAILS SECTION -->
  <section
    id="consultation"
    aria-labelledby="consultation-heading"
    class="scroll-mt-28 bg-stone-50 py-12 sm:py-16 lg:py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-20">
        
        <!-- Contact details and map -->
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out">
          <div class="mb-5 flex items-center gap-3">
            <span aria-hidden="true" class="h-px w-10 shrink-0 bg-[#D4AF67]"></span>
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
              Contact Details
            </p>
          </div>

          <h2 class="mt-4 font-serif text-3xl text-navy sm:text-4xl">
            Let’s start a conversation.
          </h2>

          <p class="mt-5 text-base leading-relaxed text-slate">
            Contact our office to discuss appointment availability,
            consultation fees and what to prepare for your visit.
          </p>

          <address
            class="mt-8 space-y-6 text-base leading-relaxed text-slate not-italic"
          >
            {
              contact.phone && (
                <div>
                  <p class="text-sm font-semibold uppercase tracking-wider text-navy">Telephone</p>
                  <a
                    href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}
                    class="mt-1 inline-flex items-center text-lg transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4"
                  >
                    {contact.phone}
                  </a>
                </div>
              )
            }

            {
              contact.email && (
                <div>
                  <p class="text-sm font-semibold uppercase tracking-wider text-navy">Email</p>
                  <a
                    href={`mailto:${contact.email}`}
                    class="mt-1 inline-flex break-all text-lg transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4"
                  >
                    {contact.email}
                  </a>
                </div>
              )
            }

            <div>
              <p class="text-sm font-semibold uppercase tracking-wider text-navy">Location</p>
              <p class="mt-2 text-lg">
                {contact.streetAddress && (
                  <span class="block">{contact.streetAddress}</span>
                )}
                <span class="block">Phuthaditjhaba, QwaQwa</span>
                <span class="block">South Africa</span>
              </p>
            </div>
          </address>

          {
            contact.officeHours && (
              <div class="mt-8 border-t border-stone-200 pt-8">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-navy">Office Hours</h3>
                <p class="mt-2 whitespace-pre-line text-lg leading-relaxed text-slate">
                  {contact.officeHours}
                </p>
              </div>
            )
          }

          <!-- Location map (Elevated) -->
          <div class="mt-10 overflow-hidden rounded-2xl border border-stone-200 shadow-md ring-1 ring-black/5">
            <iframe
              title={
                contact.streetAddress
                  ? "Map showing the location of Pahblo’s Attorneys"
                  : "Map of Phuthaditjhaba"
              }
              src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
              width="600"
              height="350"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              class="block h-80 w-full border-0 grayscale hover:grayscale-0 transition-all duration-700"
            ></iframe>
          </div>

          <a
            href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`}
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-4 inline-flex items-center gap-2 text-sm font-semibold text-navy transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4"
          >
            Open in Google Maps
            <span class="sr-only">(opens in a new tab)</span>
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
          </a>

          {
            !contact.streetAddress && (
              <p class="mt-3 text-sm leading-relaxed text-slate/80">
                This map shows the surrounding area. Confirm the exact
                office address before travelling.
              </p>
            )
          }
        </div>

        <!-- Consultation enquiry (Elevated Form Card) -->
        <div 
          class="reveal-on-scroll rounded-2xl border border-stone-100 bg-white p-6 shadow-xl shadow-navy/5 sm:p-10 opacity-0 translate-y-8 transition-all duration-1000 ease-out lg:sticky lg:top-32"
          style="transition-delay: 200ms;"
        >
          <h2
            id="consultation-heading"
            class="font-serif text-3xl text-navy"
          >
            Enquire About a Consultation
          </h2>

          <p class="mt-4 text-sm leading-relaxed text-slate">
            Share a brief outline of your matter. Appointment arrangements
            and any consultation fees will be confirmed separately.
            Fields marked * are required.
          </p>

          <form
            action={formEndpoint || undefined}
            method="POST"
            class="mt-8 space-y-6"
          >
            <div>
              <label for="contact-name" class="text-sm font-semibold text-navy">
                Full Name *
              </label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="150"
                class={fieldStyles}
              />
            </div>

            <div>
              <label for="contact-email" class="text-sm font-semibold text-navy">
                Email Address *
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
                class={fieldStyles}
              />
            </div>

            <div>
              <label for="contact-phone" class="text-sm font-semibold text-navy">
                Telephone Number <span class="font-normal text-slate/60">(optional)</span>
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                maxlength="30"
                class={fieldStyles}
              />
            </div>

            <div>
              <label
                for="contact-practice"
                class="text-sm font-semibold text-navy"
              >
                Practice Area *
              </label>
              <div class="relative">
                <select
                  id="contact-practice"
                  name="practiceArea"
                  required
                  class={`${fieldStyles} appearance-none pr-10`}
                >
                  <option value="" disabled selected>Select a service</option>
                  {
                    practiceAreas.map((area) => (
                      <option value={area}>{area}</option>
                    ))
                  }
                </select>
                <!-- Custom dropdown arrow -->
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-navy">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </div>
              </div>
            </div>

            <div>
              <label
                for="contact-message"
                class="text-sm font-semibold text-navy"
              >
                Brief Description *
              </label>

              <p id="message-help" class="mt-2 text-xs leading-relaxed text-slate/80">
                Please do not include sensitive documents or detailed
                confidential information.
              </p>

              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                maxlength="2000"
                aria-describedby="message-help"
                class:list={[fieldStyles, "resize-y mt-3"]}
              ></textarea>
            </div>

            <p class="text-xs leading-relaxed text-slate">
              Please read our
              <a
                href="/privacy"
                class="rounded-sm font-semibold text-navy underline underline-offset-4 transition-colors hover:text-[#D4AF67] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy"
              >
                Privacy Notice
              </a>
              for information about how enquiry details are handled.
              Submitting an enquiry does not appoint the firm to act on
              your behalf.
            </p>

            <button
              type="submit"
              disabled={!formEndpoint}
              class="group inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-sm bg-navy px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 enabled:hover:-translate-y-0.5 enabled:hover:bg-navy/90 enabled:hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 focus-visible:ring-offset-white disabled:cursor-not-allowed disabled:opacity-50 motion-reduce:transform-none"
            >
              Send Enquiry
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-enabled:group-hover:translate-x-1"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
            </button>

            {
              !formEndpoint && (
                <p class="text-sm text-amber-700 bg-amber-50 p-3 rounded-md border border-amber-200">
                  Online enquiries are not currently active. Please email us directly.
                </p>
              )
            }
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. EMERGENCY BAIL ASSISTANCE SECTION -->
  <section
    id="bail-assistance"
    aria-labelledby="bail-assistance-heading"
    class="relative isolate scroll-mt-28 overflow-hidden bg-navy py-16 text-white sm:py-20 lg:py-24"
  >
    <!-- Subtle urgent glow -->
    <div class="absolute left-0 top-1/2 -z-10 h-[400px] w-[400px] -translate-y-1/2 -translate-x-1/4 rounded-full bg-amber-500/10 blur-[100px]"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="reveal-on-scroll flex flex-col gap-8 opacity-0 translate-y-8 transition-all duration-1000 ease-out lg:flex-row lg:items-center lg:justify-between lg:gap-16"
      >
        <div class="max-w-2xl">
          <div class="mb-5 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-px w-10 shrink-0 bg-[#D4AF67]"
            ></span>

            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-[#E8CA90]"
            >
              24-Hour Bail Assistance
            </p>
          </div>

          <h2
            id="bail-assistance-heading"
            class="text-balance font-serif text-3xl leading-tight sm:text-4xl lg:text-5xl"
          >
            Need urgent bail assistance?
          </h2>

          <p class="mt-6 text-base leading-relaxed text-white/90 sm:text-lg">
            Call our dedicated line to request assistance with a bail
            application and discuss the circumstances of the matter immediately.
          </p>

          <p class="mt-4 flex items-start gap-3 rounded-md bg-white/5 p-4 text-sm leading-relaxed text-white/80 border border-white/10">
            <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            For urgent assistance, please telephone us rather than use
            the general enquiry form above.
          </p>
        </div>

        {
          contact.bailPhone ? (
            <div class="flex shrink-0 flex-col items-start gap-4 rounded-xl bg-black/20 p-6 ring-1 ring-white/10 lg:items-center">
              <p class="text-sm font-semibold uppercase tracking-wider text-[#E8CA90]">
                Emergency Line
              </p>
              
              <p class="font-serif text-2xl font-bold tracking-tight text-white sm:text-3xl">
                {contact.bailPhone}
              </p>

              <a
                href={`tel:${contact.bailPhone.replace(/[^\d+]/g, "")}`}
                aria-label={`Call the bail assistance line on ${contact.bailPhone}`}
                class="group mt-2 inline-flex w-full items-center justify-center gap-3 rounded-sm bg-amber-600 px-8 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-amber-500 hover:shadow-xl hover:shadow-amber-500/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-4 focus-visible:ring-offset-navy motion-reduce:transform-none"
              >
                <svg
                  aria-hidden="true"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="transition-transform duration-300 group-hover:scale-110"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.7 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.57 2.79.7A2 2 0 0 1 22 16.92z" />
                </svg>
                Call Now
              </a>
            </div>
          ) : (
            <p class="max-w-xs text-sm leading-relaxed text-[#E8CA90]/80">
              The dedicated telephone number will be displayed here
              once confirmed.
            </p>
          )
        }
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Desktop Gradient: Dark enough to hide complex background details behind the text */
  .contact-overlay {
    background: linear-gradient(
      90deg,
      rgb(10 25 47 / 96%) 0%,
      rgb(10 25 47 / 90%) 35%,
      rgb(10 25 47 / 70%) 65%,
      rgb(10 25 47 / 45%) 100%
    );
  }

  /* Mobile Background: A solid, deep navy for perfect readability */
  @media (max-width: 639px) {
    .contact-overlay {
      background: rgb(10 25 47 / 92%);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const revealOptions = {
      root: null,
      rootMargin: "0px 0px -50px 0px",
      threshold: 0.1,
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add("opacity-100", "translate-y-0");
          observer.unobserve(entry.target);
        }
      });
    }, revealOptions);

    const cards = document.querySelectorAll(".reveal-on-scroll");
    cards.forEach((card) => revealObserver.observe(card));
  });
</script>