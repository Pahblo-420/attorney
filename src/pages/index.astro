---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PracticeAreaCard from "../components/PracticeAreaCard.astro";
// 1. Import the insights data
import { insights } from "../data/insights";

// 2. Define the date formatter function
const formatArticleDate = (date: string) =>
  new Intl.DateTimeFormat("en-ZA", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));

// Reverted to original icons
const practiceAreas = [
  {
    title: "Civil Litigation",
    description: "Representation in civil disputes involving individuals, businesses and personal rights.",
    href: "/practice-areas/civil-litigation",
    icon: "M12 3v17 M5 20h14 M4 7h16 M6 7l-3 6h6L6 7Z M18 7l-3 6h6l-3-6Z",
  },
  {
    title: "Contract Law",
    description: "Legal guidance on contractual rights, obligations and disputes.",
    href: "/practice-areas/contract-law",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z M14 2v6h6 M8 12h8 M8 16h6",
  },
  {
    title: "Divorce",
    description: "Support and representation through contested and uncontested divorce proceedings.",
    href: "/practice-areas/divorce",
    icon: "M9 6a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z M21 6a3 3 0 1 1-6 0a3 3 0 0 1 6 0Z M2 20v-3a4 4 0 0 1 8 0v3 M14 20v-3a4 4 0 0 1 8 0v3 M12 4v16",
  },
  {
    title: "Labour Disputes",
    description: "Assistance with disputes between employers and employees concerning employment matters.",
    href: "/practice-areas/labour-disputes",
    icon: "M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2 M4 6h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z M2 12h20 M10 12v3h4v-3",
  },
  {
    title: "Debt Collection",
    description: "Assistance with recovering outstanding debts through appropriate legal processes.",
    href: "/practice-areas/debt-collection",
    icon: "M3 5h18v14H3V5Z M3 9h18 M7 15h3 M17 14v2 M16 15h2",
  },
  {
    title: "Immigration Law",
    description: "Advice on immigration rights and obligations, with representation in relevant proceedings.",
    href: "/practice-areas/immigration-law",
    icon: "M22 12a10 10 0 1 1-20 0a10 10 0 0 1 20 0Z M2 12h20 M12 2c3 3 4 6 4 10s-1 7-4 10c-3-3-4-6-4-10s1-7 4-10Z",
  },
  {
    title: "Insolvency & Business Rescue",
    description: "Legal guidance for financially distressed businesses exploring rescue and insolvency processes.",
    href: "/practice-areas/insolvency-business-rescue",
    icon: "M4 21V3h12v18 M16 9h4v12 M2 21h20 M8 7h4 M8 11h4 M8 15h4 M9 21v-3h2v3",
  },
  {
    title: "Conveyancing & Property Law",
    description: "Legal assistance with property purchases, transfers and related property matters.",
    href: "/practice-areas/conveyancing-property-law",
    icon: "M3 10l9-7 9 7 M5 9v12h14V9 M9 21v-8h6v8",
  },
  {
    title: "Criminal Litigation & Bail Applications",
    description: "Representation in criminal matters and 24-hour assistance with bail applications.",
    href: "/practice-areas/criminal-litigation-bail",
    icon: "M12 3l8 3v6c0 5-4 8-8 10-4-2-8-5-8-10V6l8-3Z M9 12l2 2 4-4",
  },
  {
    title: "Deceased Estates",
    description: "Professional assistance with administering a deceased estate and its related legal requirements.",
    href: "/practice-areas/deceased-estates",
    icon: "M4 4h16v17H4V4Z M8 4V2h8v2 M8 9h8 M8 13h8 M8 17h5",
  },
  {
    title: "Wills",
    description: "Assistance with preparing a will that clearly records your wishes for your estate.",
    href: "/practice-areas/wills",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z M14 2v6h6 M8 12h8 M8 17l2-2 2 2 4-3",
  },
  {
    title: "Road Accident Fund Claims",
    description: "Assistance with assessing and pursuing claims following road accident injuries or the loss of a loved one.",
    href: "/practice-areas/road-accident-fund",
    icon: "M5 10l2-6h10l2 6 M5 10h14a2 2 0 0 1 2 2v6H3v-6a2 2 0 0 1 2-2Z M5 18v3 M19 18v3 M7 14h2 M15 14h2",
  },
];
---

<BaseLayout 
  title="Pahblo's Attorneys | Legal Support for Life and Business" 
  description="From family and property matters to workplace disputes and litigation, we provide clear advice and dedicated representation to help you move forward."
>
  <Hero bailPhone="0800 123 4567" />

  <section
    id="practice-areas"
    aria-labelledby="practice-areas-heading"
    class="scroll-mt-28 bg-gradient-to-b from-ivory via-white to-white py-16 sm:py-20 lg:py-24"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-3">
          <span
            aria-hidden="true"
            class="h-px w-10 shrink-0 bg-[#D4AF67]"
          ></span>

          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
            How we can help
          </p>
        </div>

        <h2
          id="practice-areas-heading"
          class="text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl lg:text-5xl"
        >
          Our Practice Areas
        </h2>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-slate sm:text-lg">
          Whether you are facing a personal legal matter or a business
          challenge, explore our services to find the assistance you need.
        </p>
      </div>

      <div class="mt-12 grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          practiceAreas.map(({ title, description, href, icon }, index) => (
            // Cards from index 4 onwards are hidden on mobile (< 640px)
            <div class:list={[
              "h-full",
              index >= 4 ? "hidden sm:block mobile-hidden-card" : ""
            ]}>
              <PracticeAreaCard
                title={title}
                description={description}
                href={href}
              >
                <svg
                  slot="icon"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d={icon}></path>
                </svg>
              </PracticeAreaCard>
            </div>
          ))
        }
      </div>

      <!-- Mobile 'See More' Button Container -->
      <div class="mt-8 flex justify-center sm:hidden" id="see-more-container">
        <button 
          id="see-more-btn"
          type="button" 
          class="inline-flex min-h-12 w-full items-center justify-center rounded-sm border border-stone bg-white px-6 py-3 text-sm font-semibold text-navy shadow-sm transition-colors hover:bg-stone/10 active:bg-stone/20"
        >
          See all practice areas
          <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>

      <div class="mt-16 flex flex-col gap-5 border-t border-stone pt-8 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="font-serif text-xl font-semibold text-navy">
            Unsure which service you need?
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-slate">
            Get in touch with a brief outline of your matter.
          </p>
        </div>

        <a
          href="/contact#consultation"
          class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-sm bg-navy px-6 py-3 text-sm font-semibold text-white transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-navy/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 motion-reduce:transform-none motion-reduce:transition-none"
        >
          Book a Consultation
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="about-firm-heading"
    class="relative isolate overflow-hidden bg-gradient-to-b from-white to-stone-50/50 pt-8 pb-12 sm:pt-12 sm:pb-16 lg:pt-16 lg:pb-20"
  >
    <!-- Decorative background glow -->
    <div class="absolute -top-24 right-0 -z-10 h-[500px] w-[500px] translate-x-1/3 rounded-full bg-stone-200/40 blur-[100px] sm:translate-x-1/4"></div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        
        <!-- Introduction: Text Content -->
        <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out lg:col-start-2 lg:row-start-1" style="transition-delay: 200ms;">
          <div class="mb-5 flex items-center gap-3">
            <span
              aria-hidden="true"
              class="h-px w-10 shrink-0 bg-[#D4AF67]"
            ></span>

            <p
              class="text-xs font-semibold uppercase tracking-[0.2em] text-navy"
            >
              About Pahblo’s Attorneys
            </p>
          </div>

          <h2
            id="about-firm-heading"
            class="max-w-xl text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl lg:text-5xl"
          >
            Personal attention.
            <span class="mt-1 block text-[#D4AF67]">Clear legal guidance.</span>
          </h2>

          <div class="mt-8 space-y-5">
            <p class="max-w-xl text-base leading-relaxed text-slate sm:text-lg">
              Based in Phuthaditjhaba, QwaQwa, Pahblo’s Attorneys welcomes individuals,
               families and businesses seeking legal advice and representation.
               Whether you need guidance on a personal matter or support with a 
               business dispute, we take time to understand your circumstances and explain your options.
            </p>

            <p class="max-w-xl text-base leading-relaxed text-slate sm:text-lg">
              Our approach centres on clear, respectful communication. 
              We explain legal processes in plain language, keep you informed 
              as your matter progresses and discuss the proposed scope of work, fees and next steps. 
              You can expect professional service, careful attention to your concerns and practical guidance throughout your matter.
            </p>
          </div>

          <a
            href="/about"
            class="group mt-10 inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-navy px-7 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 ease-out hover:-translate-y-1 hover:bg-navy/90 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 focus-visible:ring-offset-white motion-reduce:transform-none"
          >
            About Our Firm

            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-300 group-hover:translate-x-1"
            >
              <path d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <!-- Photograph: Image Content -->
        <!-- Added 'group' and pure tailwind data states for mobile hover -->
        <div class="reveal-on-scroll about-image-wrapper group relative mx-auto w-full max-w-md opacity-0 translate-y-8 transition-all duration-1000 ease-out lg:col-start-1 lg:row-start-1 lg:mx-0 lg:max-w-lg">
          
          <!-- Filled Background Frame: Changed rounded-sm to rounded-2xl -->
          <div
            aria-hidden="true"
            class="absolute -bottom-4 -right-4 h-full w-full rounded-2xl bg-[#D4AF67]/15 border border-[#D4AF67]/30 transition-transform duration-700 ease-out group-hover:translate-x-2 group-hover:translate-y-2 max-sm:group-data-[active=true]:translate-x-2 max-sm:group-data-[active=true]:translate-y-2 sm:-bottom-6 sm:-right-6"
          ></div>

          <!-- Image Container: Changed rounded-sm to rounded-2xl -->
          <div class="relative z-10 overflow-hidden rounded-2xl shadow-2xl shadow-navy/30">
            <!-- Changed aspect-[4/3] to aspect-[4/5] (taller) and added object-top -->
            <img
              src="/images/about-firm.webp"
              alt="Pahblo’s Attorneys founder"
              width="960"
              height="1000"
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 max-sm:group-data-[active=true]:scale-105 lg:aspect-[4/5]"
            />
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <section
  aria-labelledby="client-care-heading"
  class="relative isolate overflow-hidden bg-navy py-16 sm:py-20 lg:py-24"
>
  <!-- Subtle golden background glow for depth -->
  <div class="absolute left-1/2 top-0 -z-10 h-[600px] w-[800px] -translate-x-1/2 rounded-full bg-[#D4AF67]/5 blur-[120px]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section introduction -->
    <div class="reveal-on-scroll mx-auto max-w-2xl text-center opacity-0 translate-y-8 transition-all duration-1000 ease-out">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#E8CA90]">
        Our Approach to Client Care
      </p>

      <span
        aria-hidden="true"
        class="mx-auto mt-5 block h-px w-12 bg-[#D4AF67]"
      ></span>

      <h2
        id="client-care-heading"
        class="mt-6 text-balance font-serif text-3xl leading-tight text-white sm:text-4xl lg:text-5xl"
      >
        Clear guidance at every step.
      </h2>

      <p class="mt-6 text-base leading-relaxed text-white/80 sm:text-lg">
        Seeking legal assistance can feel overwhelming. Our approach
        helps you understand your options and what comes next.
      </p>
    </div>

    <!-- Client-care commitments -->
    <div class="mt-16 grid gap-6 lg:grid-cols-3 lg:gap-8">
      
      <!-- Clear communication -->
      <!-- Clear communication -->
      <!-- Added a custom 'mobile-interactive' class for the JS to target, and pure Tailwind mobile hover states -->
      <article class="reveal-on-scroll mobile-interactive group rounded-lg border border-white/10 bg-white/5 p-8 backdrop-blur-sm opacity-0 translate-y-8 transition-all duration-700 ease-out hover:-translate-y-2 hover:border-[#D4AF67]/50 hover:bg-white/10 max-sm:group-data-[active=true]:-translate-y-2 max-sm:group-data-[active=true]:border-[#D4AF67]/50 max-sm:group-data-[active=true]:bg-white/10" style="transition-delay: 150ms;">
        <div
          aria-hidden="true"
          class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-md bg-[#D4AF67]/10 transition-colors duration-500 group-hover:bg-[#D4AF67]/20 max-sm:group-data-[active=true]:bg-[#D4AF67]/20"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8CA90" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"></path>
            <path d="M8 10h8M8 14h5"></path>
          </svg>
        </div>

        <h3 class="font-serif text-2xl text-white">
          Clear Communication
        </h3>

        <p class="mt-4 text-base leading-relaxed text-white/70 transition-colors duration-300 group-hover:text-white/90 max-sm:group-data-[active=true]:text-white/90">
          We explain your options in plain language and keep you informed
          as your matter progresses, with space to ask questions along
          the way.
        </p>
      </article>

      <!-- Personal attention -->
      <article class="reveal-on-scroll mobile-interactive group rounded-lg border border-white/10 bg-white/5 p-8 backdrop-blur-sm opacity-0 translate-y-8 transition-all duration-700 ease-out hover:-translate-y-2 hover:border-[#D4AF67]/50 hover:bg-white/10 max-sm:group-data-[active=true]:-translate-y-2 max-sm:group-data-[active=true]:border-[#D4AF67]/50 max-sm:group-data-[active=true]:bg-white/10" style="transition-delay: 300ms;">
        <div
          aria-hidden="true"
          class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-md bg-[#D4AF67]/10 transition-colors duration-500 group-hover:bg-[#D4AF67]/20 max-sm:group-data-[active=true]:bg-[#D4AF67]/20"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8CA90" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M4 21v-2a8 8 0 0 1 16 0v2"></path>
          </svg>
        </div>

        <h3 class="font-serif text-2xl text-white">
          Personal Attention
        </h3>

        <p class="mt-4 text-base leading-relaxed text-white/70 transition-colors duration-300 group-hover:text-white/90 max-sm:group-data-[active=true]:text-white/90">
          We take time to understand your circumstances, listen to your
          concerns and consider what matters to you when discussing
          your legal options.
        </p>
      </article>

      <!-- Transparent next steps -->
      <article class="reveal-on-scroll mobile-interactive group rounded-lg border border-white/10 bg-white/5 p-8 backdrop-blur-sm opacity-0 translate-y-8 transition-all duration-700 ease-out hover:-translate-y-2 hover:border-[#D4AF67]/50 hover:bg-white/10 max-sm:group-data-[active=true]:-translate-y-2 max-sm:group-data-[active=true]:border-[#D4AF67]/50 max-sm:group-data-[active=true]:bg-white/10" style="transition-delay: 450ms;">
        <div
          aria-hidden="true"
          class="mb-8 inline-flex h-14 w-14 items-center justify-center rounded-md bg-[#D4AF67]/10 transition-colors duration-500 group-hover:bg-[#D4AF67]/20 max-sm:group-data-[active=true]:bg-[#D4AF67]/20"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E8CA90" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"></path>
            <rect x="9" y="2" width="6" height="4" rx="1"></rect>
            <path d="m8 13 2 2 6-6M8 18h8"></path>
          </svg>
        </div>

        <h3 class="font-serif text-2xl text-white">
          Transparent Next Steps
        </h3>

        <p class="mt-4 text-base leading-relaxed text-white/70 transition-colors duration-300 group-hover:text-white/90 max-sm:group-data-[active=true]:text-white/90">
          We discuss the proposed approach, scope of work and fees so you
          understand the next steps before deciding how to proceed.
        </p>
      </article>

    </div>
  </div>
</section>
<section
  aria-labelledby="attorneys-heading"
  class="relative isolate overflow-hidden bg-stone-50 pt-20 pb-10 sm:pt-24 sm:pb-12 lg:pt-32 lg:pb-16"
>
  <!-- Decorative background glow for subtle texture -->
  <div class="absolute left-0 top-1/2 -z-10 h-[500px] w-[500px] -translate-y-1/2 -translate-x-1/4 rounded-full bg-white blur-[100px]"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Section introduction -->
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="reveal-on-scroll max-w-2xl opacity-0 translate-y-8 transition-all duration-1000 ease-out">
        <div class="mb-5 flex items-center gap-3">
          <span
            aria-hidden="true"
            class="h-px w-10 shrink-0 bg-[#D4AF67]"
          ></span>

          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-navy">
            The People Behind the Firm
          </p>
        </div>

        <h2
          id="attorneys-heading"
          class="text-balance font-serif text-3xl leading-tight text-navy sm:text-4xl lg:text-5xl"
        >
          Meet Our Attorneys
        </h2>

        <p class="mt-5 max-w-xl text-base leading-relaxed text-slate sm:text-lg">
          Get to know the attorneys who assist our clients in
          Phuthaditjhaba, QwaQwa, and beyond.
        </p>
      </div>

      <div class="reveal-on-scroll opacity-0 translate-y-8 transition-all duration-1000 ease-out" style="transition-delay: 200ms;">
        <a
          href="/our-attorneys"
          class="group inline-flex min-h-12 shrink-0 items-center justify-center gap-2 self-start rounded-sm border border-navy/20 bg-white px-7 py-3 text-sm font-semibold text-navy shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:border-navy hover:bg-navy hover:text-white hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-navy focus-visible:ring-offset-4 focus-visible:ring-offset-stone-50 motion-reduce:transform-none"
        >
          Meet the Full Team
          <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>

    <!-- Attorney Cards Grid -->
    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        [
          {
            name: "Paballo Lipopo",
            role: "Director & Attorney",
            qualification: "LLB · University of the Free State",
            areas: "Civil Litigation · Contract Law · Labour Disputes",
            introduction:
              "Assists individuals and businesses with civil disputes, contractual matters and employment-related concerns.",
            image: "/images/attorney-1.webp",
            href: "/our-attorneys#attorney-one",
          },
          {
            name: "Thandiwe Nkosi",
            role: "Attorney",
            qualification: "LLB · University of the Witwatersrand",
            areas: "Divorce · Criminal Litigation · Bail Applications",
            introduction:
              "Supports clients through divorce proceedings and criminal matters, including applications for bail.",
            image: "/images/attorney-2.webp",
            href: "/our-attorneys#attorney-two",
          },
          {
            name: "Tshepo Mokoena",
            role: "Attorney",
            qualification: "LLB · University of South Africa",
            areas: "Property Law · Deceased Estates · Wills",
            introduction:
              "Assists clients with property-related matters, deceased estate administration and the preparation of wills.",
            image: "/images/attorney-3.webp",
            href: "/our-attorneys#attorney-three",
          },
        ].map(
          ({
            name,
            role,
            qualification,
            areas,
            introduction,
            image,
            href,
          }) => (
            <article class="reveal-on-scroll mobile-interactive group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-md opacity-0 translate-y-8 transition-all duration-700 ease-out hover:-translate-y-2 hover:shadow-xl max-sm:group-data-[active=true]:-translate-y-2 max-sm:group-data-[active=true]:shadow-xl">
              
              <!-- Image Container with Zoom Effect -->
              <div class="relative overflow-hidden bg-navy/5">
                <img
                  src={image}
                  alt={`Portrait of ${name}`}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 max-sm:group-data-[active=true]:scale-105"
                />
                <!-- Subtle inner shadow overlay -->
                <div class="absolute inset-0 ring-1 ring-inset ring-black/5"></div>
              </div>

              <!-- Card Content -->
